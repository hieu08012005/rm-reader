{
  "name": "rm-reader",
  "version": "1.5.1",
  "description": "Đọc reference manual PDF và dịch thuật ngữ lập trình nhúng sang tiếng Việt",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "RM Reader",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:app": "node tests/app-smoke.mjs",
    "test:packaged": "node tests/app-smoke.mjs --packaged",
    "package": "npm run build && electron-builder --win --dir",
    "portable": "npm run build && electron-builder --win portable",
    "test:compare": "node tests/compare-notes.mjs",
    "test:compare:packaged": "node tests/compare-notes.mjs --packaged",
    "test:markup": "node tests/markup-tools.mjs",
    "test:markup:packaged": "node tests/markup-tools.mjs --packaged",
    "test:attachments": "node tests/attachments-app.mjs",
    "test:attachments:packaged": "node tests/attachments-app.mjs --packaged",
    "test:chat": "node tests/chat-app.mjs",
    "test:chat:packaged": "node tests/chat-app.mjs --packaged",
    "test:chat-images": "node tests/chat-images-app.mjs",
    "test:chat-images:packaged": "node tests/chat-images-app.mjs --packaged"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.0",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "vn.rmreader.desktop",
    "productName": "RM Reader",
    "directories": {
      "output": "E:/App_RM/release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/core/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "artifactName": "RM-Reader-${version}.${ext}",
      "signExecutable": false,
      "icon": "build/app-icon.ico"
    }
  }
}
